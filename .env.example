# Local development configuration. Keep this file free of real secrets.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Leave DATABASE_URL unset to use the isolated SQLite database in instance/acadpulse_dev.db.
# Example PostgreSQL URL for a future configured environment:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/acadpulse
CURRENT_ACADEMIC_YEAR=2026-27
MAX_CONTENT_LENGTH=16777216
UPLOAD_ROOT=uploads
REPORTS_ROOT=reports
